{
  "name": "byheart",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Compile successful computer-use experience into replayable capabilities.",
  "bin": {
    "byheart": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "demo": "npm run build && node dist/src/demo.js",
    "demo:target": "node demo/legacy-console/server.mjs",
    "browser:install": "playwright install chromium",
    "byheart": "npm run build && node dist/src/cli.js",
    "evidence:replays": "npm run build && node scripts/capture-takehome-replays.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  }
}
